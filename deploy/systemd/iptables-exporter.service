[Unit]
Description=iptables Prometheus exporter
Documentation=https://github.com/redhatua/iptables-exporter
After=network-online.target
Wants=network-online.target

[Service]
User=iptables-exporter
Group=iptables-exporter
ExecStart=/usr/local/bin/iptables-exporter
Restart=on-failure
RestartSec=5s

# CAP_NET_ADMIN is required to read the ruleset and also permits modifying it.
# The exporter only ever runs "*-save -c". Do NOT enable PrivateNetwork: it hides the host rules.
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_DAC_READ_SEARCH
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_DAC_READ_SEARCH
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
